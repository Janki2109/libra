<?xml version="1.0" encoding="utf-8"?>
<!--
  The manifest previously set android:usesCleartextTraffic="true", which allows
  the app to talk to ANY host over plain HTTP — in release builds, on customer
  devices. This app carries privileged client case files and a bearer token, so
  a shipped build must refuse plaintext outright.

  This config keeps TLS mandatory everywhere and carves out only the loopback
  addresses a developer needs for a local API:
    10.0.2.2  — the host machine as seen from the Android emulator
    127.0.0.1 / localhost — a device on a reverse-forwarded port (adb reverse)

  Local development (flutter run / flutter build apk, debug mode) does NOT rely
  on this file at all — src/debug/res/xml/network_security_config.xml
  overrides it for every debug build with a broad cleartext allowance, so
  testing against a LAN backend never requires hardcoding or updating an IP
  here. This file only matters for a RELEASE build, where cleartext stays
  refused except for the loopback hosts below.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <!-- If you specifically need a RELEASE build to reach a LAN dev
             backend (rare — debug builds already cover this via the
             src/debug override above), add your current LAN IP here, e.g.:
               <domain includeSubdomains="false">192.168.1.7</domain>
             Find it with `ipconfig` (IPv4 Address). It will go stale again
             whenever your machine gets a new DHCP lease. -->
    </domain-config>
</network-security-config>

# =============================================
# Libra Law Practice — environment template
#
# Copy to backend/.env for local work, or set these as real environment
# variables in your host's dashboard for a deployment.
#
# NEVER commit a filled-in copy. The repo previously shipped backend/.env with
# a live JWT secret in it; if you have cloned an older revision, treat every
# value that was in it as compromised and rotate it.
# =============================================

# ─── SERVER ──────────────────────────────────
PORT=8080
# 'production' turns on release mode, hides internal error details from API
# responses, and makes config validation fatal rather than advisory.
APP_ENV=development

# Set to false if migrations are applied by a separate deploy step.
RUN_MIGRATIONS=true

# ─── DATABASE ────────────────────────────────
# Either set DATABASE_URL, or the six DB_* variables below.
# DATABASE_URL=postgres://user:pass@host:5432/libra_law?sslmode=require
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=libra_law
# 'disable' is refused in production — case files would travel unencrypted.
DB_SSLMODE=require

# ─── AUTH ────────────────────────────────────
# Generate a fresh one. The server refuses to start in production on the value
# that used to be committed here.
#   openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRY=24h

# ─── CORS ────────────────────────────────────
# Comma-separated exact origins. Leave empty for a mobile-only API — mobile
# clients send no Origin header. Never set this to "*".
# CORS_ORIGINS=https://app.libralaw.in,https://admin.libralaw.in
CORS_ORIGINS=

# Adds Strict-Transport-Security. Turn on once TLS terminates in front.
FORCE_HTTPS=false

# ─── EMAIL (required) ────────────────────────
# Verification codes and client-portal invitations are delivered here. Without
# it, OTP login and portal onboarding do not work — codes are only printed to
# the server log, and only outside production.
# Gmail needs an App Password, not the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Libra Law

# ─── PAYMENTS ────────────────────────────────
# Required to charge for subscriptions. With these unset the payment endpoints
# return 503 rather than accepting unverified payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# The webhook is the AUTHORITATIVE activation path — a user who kills the app
# straight after paying never reaches the in-app callback, and without this
# their card is charged and their plan never activates. Startup refuses if the
# gateway keys are set and this is not.
#
# In the Razorpay dashboard: Settings → Webhooks → Add
#   URL:    https://your-api-host/api/v1/webhooks/razorpay
#   Events: payment.captured, payment.failed, order.paid
#   Secret: the value below
RAZORPAY_WEBHOOK_SECRET=

# ─── AI LEGAL DRAFTING (optional) ────────────
# Groq API keys for the AI drafting feature. Server-side only — never expose
# these to the Flutter app. Add as many as you have (GROQ_API_KEY_1,
# GROQ_API_KEY_2, ...); the backend rotates through them in order and skips
# any that are temporarily rate-limited/failing. Without at least one, the
# drafting endpoint returns a 503 rather than a stale/fake response.
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=

# ─── PUSH NOTIFICATIONS (optional) ───────────
# A Firebase service-account JSON (Firebase Console → Project Settings →
# Service Accounts → Generate new private key). This is NOT the app's
# google-services.json — never put this file or its contents in the Flutter
# app. Without one of these set, push notifications (including incoming-call
# alerts) are skipped but the existing in-app notifications table still works
# exactly as before. Set exactly one: a file path, or the raw JSON pasted
# into the _JSON var (easier on hosts like Render's free tier where
# uploading a secret file is an extra manual step).
FIREBASE_CREDENTIALS_FILE=
FIREBASE_CREDENTIALS_JSON=

# ─── COURT DATA (optional) ───────────────────
# Free access — see docs/court-data.md for how to obtain it from NIC or a
# gateway free tier. With this unset, the court endpoints return 503 and the
# app falls back to manually entered hearing data.
ECOURTS_API_BASE=
ECOURTS_API_KEY=

# ─── FILE STORAGE (optional) ─────────────────
# Documents are currently stored inline in Postgres as base64, capped at 8 MB.
# Move them to object storage before real volume.
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=ap-south-1
AWS_BUCKET=

APP_URL=http://localhost:8080
